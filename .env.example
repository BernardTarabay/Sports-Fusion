# ---------------------------------------------------------------------------
# Sports Fusion - local development
# Copy to .env and adjust. .env is gitignored; never commit real credentials.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
PUBLIC_WEB_URL=http://localhost:5173

# Postgres
POSTGRES_USER=sportsfusion
POSTGRES_PASSWORD=sportsfusion_dev
POSTGRES_DB=sportsfusion
POSTGRES_PORT=5432
DATABASE_URL=postgresql://sportsfusion:sportsfusion_dev@localhost:5432/sportsfusion

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Auth. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_DOMAIN=localhost
BCRYPT_ROUNDS=12

# Seed. The admin account created by `npm run seed`. Password is generated and printed
# once if not set. Setting a phone lets the admin sign in with a WhatsApp code.
SEED_ADMIN_EMAIL=admin@sportsfusion.app
SEED_ADMIN_PHONE=
SEED_ADMIN_PASSWORD=

# Team balancer
BALANCER_SHORTLIST_SIZE=50
BALANCER_ALGORITHM_VERSION=exhaustive_v1

# Where login codes go: log | whatsapp | twilio.
#
# 'log' is the default and means "nowhere" -- the code is written to the server log and
# handed back in the API response so local development works with no provider account.
# That last part is a complete authentication bypass, so it is refused when
# NODE_ENV=production: phone sign-in answers 503 there until a real provider is set.
OTP_PROVIDER=log

# Twilio, for codes over SMS. Set OTP_PROVIDER=twilio to use it.
#
# Reaches everyone with a phone rather than everyone with WhatsApp, and needs no Meta
# Business account, business verification or template approval -- which is why it exists
# alongside the WhatsApp path.
#
# SID and token: Twilio console home, "Account Info".
#
# Then EITHER a sender number OR a Messaging Service, not both -- the service wins when
# set. Prefer the service: it handles sender selection, STOP/opt-outs and per-country
# rules that a bare number does not.
#
# A TRIAL ACCOUNT WILL ONLY TEXT NUMBERS YOU HAVE VERIFIED in Phone Numbers > Verified
# Caller IDs. Everything else fails with code 21608, which reads like a configuration
# error and is not one.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=

# WhatsApp Business Platform (Cloud API).
# NOTE: 1:1 messaging only. The platform cannot post into WhatsApp groups or
# communities; group announcements are generated for an admin to copy/paste.
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0

# The AUTHENTICATION template that carries the login code. These three must match what
# Meta approved, exactly -- it rejects the message otherwise, with an error that names a
# parameter index rather than the problem.
#   NAME        whatever you called it in the WhatsApp Manager
#   HAS_BUTTON  true if it has a "copy code" button. Meta then REQUIRES the code sent
#               again as a button parameter; sending one when the template has no button
#               is rejected just as hard.
#   LANGUAGE    'en' and 'en_US' are different templates as far as the API is concerned
WHATSAPP_TEMPLATE_NAME=login_code
WHATSAPP_TEMPLATE_HAS_BUTTON=true
WHATSAPP_TEMPLATE_LANGUAGE=en

# Shopify
SHOPIFY_ENABLED=false
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_WEBHOOK_SECRET=

# Gemini
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
